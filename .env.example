# ===== Supabase (projeto NOVO e dedicado do Sales Brain 2.0) =====
# Onde encontrar: painel do Supabase → Project Settings → API
# URL do projeto (ex.: https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública "anon" — pode ir para o navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — SÓ no servidor. NUNCA compartilhar nem commitar.
# Usada pelo script de migração e por ações administrativas do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ===== App =====
# URL pública do app (em produção: https://salesbrain.doutor-ai.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
